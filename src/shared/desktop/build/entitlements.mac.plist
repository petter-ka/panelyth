<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime entitlements of the signed macOS app (Stage P06).
     Chromium's V8 needs writable and executable memory; nothing else is asked for:
     no camera, microphone, location, or Apple Events. The sidecar and the
     bundled ffmpeg inherit these and use none of them. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
