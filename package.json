{
  "name": "panelyth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:sidecar && pnpm -r --filter @panelyth/renderer --filter @panelyth/commander --filter @panelyth/docviewer --filter @panelyth/desktop build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "start": "node scripts/start.mjs",
    "package": "node scripts/package.mjs",
    "notices": "node scripts/notices.mjs",
    "media-tools": "node scripts/media-tools.mjs",
    "test:smoke": "pnpm --filter @panelyth/e2e smoke",
    "test:update": "pnpm --filter @panelyth/e2e run update-test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && node scripts/go.mjs fmt-check && node scripts/go.mjs vet",
    "format": "prettier --write . && node scripts/go.mjs fmt",
    "test": "pnpm build:sidecar && pnpm -r --filter !@panelyth/e2e test && pnpm test:go",
    "test:go": "node scripts/go.mjs test",
    "test:e2e": "pnpm build && pnpm --filter @panelyth/e2e test",
    "bench:go": "node scripts/go.mjs bench",
    "bench:startup": "pnpm build && pnpm --filter @panelyth/bench startup",
    "bench:bundle": "node scripts/bundle-size.mjs",
    "bench:index": "node scripts/go.mjs indexbench",
    "bench:previews": "node scripts/go.mjs thumbbench",
    "bench:find": "node scripts/go.mjs findbench",
    "bench:archives": "node scripts/go.mjs archivebench",
    "bench:compare": "node scripts/go.mjs comparebench",
    "bench:rename": "node scripts/go.mjs renamebench",
    "bench:edit": "node scripts/go.mjs editbench"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
